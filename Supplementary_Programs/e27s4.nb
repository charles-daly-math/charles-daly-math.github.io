      RowBox[{"(", "k4s3", ")"}], " ", "--"}]}], ">", " ", 
    RowBox[{"SO", 
     RowBox[{"(", 
      RowBox[{"6", ",", "R"}], ")"}]}]}], "*)"}], " ", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
   "here", " ", "we", " ", "construct", " ", "an", " ", "isomorphism", " ", 
    "between", " ", "e27"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3", "rd", " ", "root", " ", "of", " ", "unity", " ", "and", " ", "a", " ",
     "2", "x2", " ", "real", " ", "matrix", " ", "rep", " ", "of", " ", "it", 
    " ", "via", " ", 
    RowBox[{"rot", "[", "angle", "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"omega", "=", 
     RowBox[{"2", 
      RowBox[{"Pi", "/", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rot", "[", "theta_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "theta", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "theta", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "theta", "]"}], ",", 
         RowBox[{"Cos", "[", "theta", "]"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Momega", "=", 
     RowBox[{"rot", "[", "omega", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"a", " ", "reflection", " ", "element", " ", "matrix"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ref", "=", 
