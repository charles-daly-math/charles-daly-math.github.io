        RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "function", " ", "that", " ", "eats", " ", "up", " ", "a", " ", 
       "permutation", " ", "in", " ", "s3", " ", "and", " ", "spits", " ", 
       "out", " ", "the", " ", "permutation", " ", "on", " ", "the", " ", 
       "blocks", " ", "R2"}], "+", "R2", "+", 
      RowBox[{
      "R2", " ", "where", " ", "it", " ", "acts", " ", "by", " ", "sending", 
       " ", "oriented", " ", "bases", " ", "to", " ", "oriented", " ", 
       "bases"}]}], ";", " ", 
     RowBox[{"so", " ", "for", " ", "example", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], " ", "will", " ", 
      "get", " ", "sent", " ", "to", " ", "the", " ", "permutation", " ", 
      "that", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4", ",", "6"}], "}"}]}], "}"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"blockcycle", "[", "listofcycles_", "]"}], ":=", 
     RowBox[{"Join", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{"listofcycles", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ")"}]}], "-", 
          RowBox[{"(", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"listofcycles", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "listofcycles", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"listofcycles", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "listofcycles", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Matrix", " ", "representation", " ", "of", " ", "k4"}], ",", 
     " ", "here", ",", " ", 
     RowBox[{"upto", " ", "isomorphism"}], ",", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "first", " ", "blockdiagonal", " ", "matrix", " ", "is", 
       " ", "k1", " ", "and", " ", "the", " ", "second", " ", "one", " ", 
       "is", " ", "k3"}], ";"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Mk4", "[", "v1_", "]"}], ":=", 
     RowBox[{
      RowBox[{"MatrixPower", "[", 
