        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"v1", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", "2"}], "]"}]}], "]"}], ".", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"BlockDiagonalMatrix", "[", 
         RowBox[{"{", 
