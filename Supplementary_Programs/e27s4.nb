          RowBox[{
           RowBox[{"g1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"g2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
