        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2", "x2", " ", "identity", " ", "matrix", " ", "and", " ", "2", "x2", 
     " ", "zero", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"id2", "=", 
