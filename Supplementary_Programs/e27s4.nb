        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"v1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "2"}], "]"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Matrix", " ", "representation", " ", "of", " ", "s3"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ms3", "[", "perm_", "]"}], ":=", 
