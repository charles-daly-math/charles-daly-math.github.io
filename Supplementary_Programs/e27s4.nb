         RowBox[{"Momega", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"m3", ",", "3"}], "]"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
